# ============================================================================
# ZXHEIFI - MIKROTIK hAP lite (RB941-2nD) FULL CONFIG (manual import)
# ============================================================================
# GENERATED by desktop-app/export_rsc.py from the same plan the desktop
# app's Configure MikroTik tab runs - edit mikrotik_commands.py, not this.
#
# The desktop app is the recommended way: it checks it is talking to the
# right router first and fills in the MAC/password values for you.
#
# Before importing:
#   1. Router reset with "No Default Configuration", RouterOS 7.x.
#   2. 192.168.88.1/24 added on ether2, PC plugged into ether2.
#   3. hotspot package installed (RouterOS 7 hAP lite needs the extra package).
#   4. Edit the values below.
# Import: upload this file in Winbox > Files, then in New Terminal:
#   /import file-name=hAP_lite_full_config.rsc
# Then upload mikrotik/gui/* into the router's hotspot folder.
#
# Ports: ether1 = internet (WAN), all other ports + wlan1 = hotspot.
# Daily reboot needs the scheduler allowed in device-mode (see the guide).
# ============================================================================

# ---- EDIT THESE -------------------------------------------------------------
:global zxSsid "ZXHEIFI"
#   ^ WiFi name customers see (hAP lite only)
:global zxNodemcuIP "10.0.0.254"
#   ^ Address reserved for the NodeMCU
:global zxNodemcuMAC "aa:bb:cc:dd:ee:ff"
#   ^ NodeMCU MAC - the desktop app's Flasher tab shows it
:global zxApiPass "CHANGE-ME-8plus"
#   ^ Password the NodeMCU logs in with - enter the same one in its setup wizard
:global zxDown "70M"
#   ^ ~90% of your real download speed
:global zxUp "20M"
#   ^ ~90% of your real upload speed

# ============================================================================
# 1. BASE NETWORK
#    WAN, LAN bridge, DHCP, DNS, NAT and a firewall that blocks the internet side without cutting off your own LAN/PPPoE users.
# ============================================================================
:put "ZxheiFi: Base Network"
:do { /ip firewall filter remove [/ip firewall filter find where comment="Drop all other input"] } on-error={ :put "  FAILED: Remove old 'Drop all other input' rule (older ZxheiFi version)" }
:do { /ip firewall filter remove [/ip firewall filter find where comment="Drop other forward"] } on-error={ :put "  FAILED: Remove old 'Drop other forward' rule (older ZxheiFi version)" }
:do { :if ([:len [/interface bridge find where name="zxheifi-lan"]] = 0) do={ /interface bridge add name="zxheifi-lan" protocol-mode="none" comment="zxheifi" } else={ /interface bridge set [/interface bridge find where name="zxheifi-lan"] name="zxheifi-lan" protocol-mode="none" comment="zxheifi" } } on-error={ :put "  FAILED: Hotspot LAN bridge" }
:do { :if ([:len [/ip address find where comment="zxheifi: setup access"]] = 0) do={ /ip address add address="192.168.88.1/24" interface="zxheifi-lan" comment="zxheifi: setup access" } else={ /ip address set [/ip address find where comment="zxheifi: setup access"] address="192.168.88.1/24" interface="zxheifi-lan" comment="zxheifi: setup access" } } on-error={ :put "  FAILED: Keep setup access on the bridge" }
:do { :if ([:len [/interface bridge port find where interface="ether2"]] = 0) do={ /interface bridge port add bridge="zxheifi-lan" interface="ether2" comment="zxheifi" } else={ :put "  skipped (already exists, not created by ZxheiFi): Add ether2 to hotspot LAN bridge" } } on-error={ :put "  FAILED: Add ether2 to hotspot LAN bridge" }
:do { :if ([:len [/interface bridge port find where interface="ether3"]] = 0) do={ /interface bridge port add bridge="zxheifi-lan" interface="ether3" comment="zxheifi" } else={ :put "  skipped (already exists, not created by ZxheiFi): Add ether3 to hotspot LAN bridge" } } on-error={ :put "  FAILED: Add ether3 to hotspot LAN bridge" }
:do { :if ([:len [/interface bridge port find where interface="ether4"]] = 0) do={ /interface bridge port add bridge="zxheifi-lan" interface="ether4" comment="zxheifi" } else={ :put "  skipped (already exists, not created by ZxheiFi): Add ether4 to hotspot LAN bridge" } } on-error={ :put "  FAILED: Add ether4 to hotspot LAN bridge" }
:do { :if ([:len [/interface bridge port find where interface="wlan1"]] = 0) do={ /interface bridge port add bridge="zxheifi-lan" interface="wlan1" comment="zxheifi" } else={ :put "  skipped (already exists, not created by ZxheiFi): Add wlan1 to hotspot LAN bridge" } } on-error={ :put "  FAILED: Add wlan1 to hotspot LAN bridge" }
:do { :if ([:len [/ip dhcp-client find where interface="ether1"]] = 0) do={ /ip dhcp-client add interface="ether1" disabled="no" comment="zxheifi: WAN" } else={ :put "  skipped (already exists, not created by ZxheiFi): WAN DHCP client" } } on-error={ :put "  FAILED: WAN DHCP client" }
:do { :if ([:len [/ip address find where comment="zxheifi: LAN gateway"]] = 0) do={ /ip address add address="10.0.0.1/24" interface="zxheifi-lan" comment="zxheifi: LAN gateway" } else={ /ip address set [/ip address find where comment="zxheifi: LAN gateway"] address="10.0.0.1/24" interface="zxheifi-lan" comment="zxheifi: LAN gateway" } } on-error={ :put "  FAILED: LAN gateway IP" }
:do { /ip dns set servers="8.8.8.8,1.1.1.1" allow-remote-requests="yes" } on-error={ :put "  FAILED: Router DNS" }
:do { :if ([:len [/ip pool find where name="zxheifi-dhcp-pool"]] = 0) do={ /ip pool add name="zxheifi-dhcp-pool" ranges="10.0.0.100-10.0.0.200" } else={ /ip pool set [/ip pool find where name="zxheifi-dhcp-pool"] name="zxheifi-dhcp-pool" ranges="10.0.0.100-10.0.0.200" } } on-error={ :put "  FAILED: DHCP pool" }
:do { :if ([:len [/ip dhcp-server find where name="zxheifi-dhcp"]] = 0) do={ /ip dhcp-server add name="zxheifi-dhcp" interface="zxheifi-lan" address-pool="zxheifi-dhcp-pool" disabled="no" } else={ /ip dhcp-server set [/ip dhcp-server find where name="zxheifi-dhcp"] name="zxheifi-dhcp" interface="zxheifi-lan" address-pool="zxheifi-dhcp-pool" disabled="no" } } on-error={ :put "  FAILED: DHCP server" }
:do { :if ([:len [/ip dhcp-server network find where address="10.0.0.0/24"]] = 0) do={ /ip dhcp-server network add address="10.0.0.0/24" gateway="10.0.0.1" dns-server="10.0.0.1" comment="zxheifi" } else={ :put "  skipped (already exists, not created by ZxheiFi): DHCP network" } } on-error={ :put "  FAILED: DHCP network" }
:global zxNodemcuIP; :global zxNodemcuMAC; :do { :if ([:len [/ip dhcp-server lease find where mac-address=$zxNodemcuMAC]] = 0) do={ /ip dhcp-server lease add address=$zxNodemcuIP mac-address=$zxNodemcuMAC server="zxheifi-dhcp" comment="zxheifi: NodeMCU" } else={ :put "  skipped (already exists, not created by ZxheiFi): NodeMCU static DHCP lease" } } on-error={ :put "  FAILED: NodeMCU static DHCP lease" }
:global zxNodemcuIP; :do { :if ([:len [/ip dns static find where name="nodemcu.zxheifi.lan"]] = 0) do={ /ip dns static add name="nodemcu.zxheifi.lan" address=$zxNodemcuIP comment="zxheifi" } else={ /ip dns static set [/ip dns static find where name="nodemcu.zxheifi.lan"] name="nodemcu.zxheifi.lan" address=$zxNodemcuIP comment="zxheifi" } } on-error={ :put "  FAILED: NodeMCU DNS name" }
:do { :if ([:len [/ip firewall nat find where comment="zxheifi: internet NAT"]] = 0) do={ /ip firewall nat add chain="srcnat" out-interface="ether1" action="masquerade" comment="zxheifi: internet NAT" } else={ /ip firewall nat set [/ip firewall nat find where comment="zxheifi: internet NAT"] chain="srcnat" out-interface="ether1" action="masquerade" comment="zxheifi: internet NAT" } } on-error={ :put "  FAILED: Internet NAT" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: accept established (input)"]] = 0) do={ /ip firewall filter add chain="input" action="accept" connection-state="established,related,untracked" comment="zxheifi: accept established (input)" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: accept established (input)"] chain="input" action="accept" connection-state="established,related,untracked" comment="zxheifi: accept established (input)" } } on-error={ :put "  FAILED: Firewall: accept established (input)" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: drop invalid (input)"]] = 0) do={ /ip firewall filter add chain="input" action="drop" connection-state="invalid" comment="zxheifi: drop invalid (input)" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: drop invalid (input)"] chain="input" action="drop" connection-state="invalid" comment="zxheifi: drop invalid (input)" } } on-error={ :put "  FAILED: Firewall: drop invalid (input)" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: accept ICMP"]] = 0) do={ /ip firewall filter add chain="input" action="accept" protocol="icmp" comment="zxheifi: accept ICMP" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: accept ICMP"] chain="input" action="accept" protocol="icmp" comment="zxheifi: accept ICMP" } } on-error={ :put "  FAILED: Firewall: accept ICMP" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: drop input from WAN"]] = 0) do={ /ip firewall filter add chain="input" action="drop" in-interface="ether1" comment="zxheifi: drop input from WAN" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: drop input from WAN"] chain="input" action="drop" in-interface="ether1" comment="zxheifi: drop input from WAN" } } on-error={ :put "  FAILED: Firewall: drop input from WAN" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: accept established (forward)"]] = 0) do={ /ip firewall filter add chain="forward" action="accept" connection-state="established,related,untracked" comment="zxheifi: accept established (forward)" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: accept established (forward)"] chain="forward" action="accept" connection-state="established,related,untracked" comment="zxheifi: accept established (forward)" } } on-error={ :put "  FAILED: Firewall: accept established (forward)" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: drop invalid (forward)"]] = 0) do={ /ip firewall filter add chain="forward" action="drop" connection-state="invalid" comment="zxheifi: drop invalid (forward)" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: drop invalid (forward)"] chain="forward" action="drop" connection-state="invalid" comment="zxheifi: drop invalid (forward)" } } on-error={ :put "  FAILED: Firewall: drop invalid (forward)" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: drop new from WAN not DSTNATed"]] = 0) do={ /ip firewall filter add chain="forward" action="drop" connection-state="new" connection-nat-state="!dstnat" in-interface="ether1" comment="zxheifi: drop new from WAN not DSTNATed" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: drop new from WAN not DSTNATed"] chain="forward" action="drop" connection-state="new" connection-nat-state="!dstnat" in-interface="ether1" comment="zxheifi: drop new from WAN not DSTNATed" } } on-error={ :put "  FAILED: Firewall: drop new from WAN not DSTNATed" }

# ============================================================================
# 2. WIFI SETUP
#    Configures the hAP lite's own radio as the customer-facing AP.
# ============================================================================
:put "ZxheiFi: WiFi Setup"
:do { :if ([:len [/interface wireless security-profiles find where name="zxheifi-open"]] = 0) do={ /interface wireless security-profiles add name="zxheifi-open" mode="none" } else={ /interface wireless security-profiles set [/interface wireless security-profiles find where name="zxheifi-open"] name="zxheifi-open" mode="none" } } on-error={ :put "  FAILED: Open WiFi (no password - customers pay on the login page)" }
:global zxSsid; :do { /interface wireless set [/interface wireless find where name="wlan1"] mode="ap-bridge" ssid=$zxSsid band="2ghz-b/g/n" channel-width="20/40mhz-XX" frequency="auto" wireless-protocol="802.11" distance="indoors" security-profile="zxheifi-open" disabled="no" } on-error={ :put "  FAILED: wlan1 as the ZxheiFi access point" }

# ============================================================================
# 3. HOTSPOT
#    Hotspot server, login page, the 3 speed profiles vouchers/coins use, and the walled-garden entry that lets the login page reach the NodeMCU.
# ============================================================================
:put "ZxheiFi: Hotspot"
:do { :if ([:len [/ip pool find where name="zxheifi-hs-pool"]] = 0) do={ /ip pool add name="zxheifi-hs-pool" ranges="10.0.0.10-10.0.0.99" } else={ /ip pool set [/ip pool find where name="zxheifi-hs-pool"] name="zxheifi-hs-pool" ranges="10.0.0.10-10.0.0.99" } } on-error={ :put "  FAILED: Hotspot address pool" }
:do { :if ([:len [/ip hotspot profile find where name="zxheifi-hs"]] = 0) do={ /ip hotspot profile add name="zxheifi-hs" hotspot-address="10.0.0.1" dns-name="login.zxheifi.lan" html-directory="hotspot" login-by="http-chap,http-pap" http-cookie-lifetime="1d" } else={ /ip hotspot profile set [/ip hotspot profile find where name="zxheifi-hs"] name="zxheifi-hs" hotspot-address="10.0.0.1" dns-name="login.zxheifi.lan" html-directory="hotspot" login-by="http-chap,http-pap" http-cookie-lifetime="1d" } } on-error={ :put "  FAILED: Hotspot profile" }
:do { :if ([:len [/ip hotspot find where name="zxheifi-hotspot"]] = 0) do={ /ip hotspot add name="zxheifi-hotspot" interface="zxheifi-lan" profile="zxheifi-hs" address-pool="zxheifi-hs-pool" idle-timeout="15m" keepalive-timeout="2m" disabled="no" } else={ /ip hotspot set [/ip hotspot find where name="zxheifi-hotspot"] name="zxheifi-hotspot" interface="zxheifi-lan" profile="zxheifi-hs" address-pool="zxheifi-hs-pool" idle-timeout="15m" keepalive-timeout="2m" disabled="no" } } on-error={ :put "  FAILED: Hotspot server" }
:do { :if ([:len [/ip hotspot user profile find where name="hs-default"]] = 0) do={ /ip hotspot user profile add name="hs-default" rate-limit="5M/10M" shared-users="1" transparent-proxy="no" } else={ /ip hotspot user profile set [/ip hotspot user profile find where name="hs-default"] name="hs-default" rate-limit="5M/10M" shared-users="1" transparent-proxy="no" } } on-error={ :put "  FAILED: Hotspot speed profile 1" }
:do { :if ([:len [/ip hotspot user profile find where name="hs-gaming"]] = 0) do={ /ip hotspot user profile add name="hs-gaming" rate-limit="10M/30M" shared-users="1" transparent-proxy="no" } else={ /ip hotspot user profile set [/ip hotspot user profile find where name="hs-gaming"] name="hs-gaming" rate-limit="10M/30M" shared-users="1" transparent-proxy="no" } } on-error={ :put "  FAILED: Hotspot speed profile 2" }
:do { :if ([:len [/ip hotspot user profile find where name="hs-high"]] = 0) do={ /ip hotspot user profile add name="hs-high" rate-limit="20M/50M" shared-users="1" transparent-proxy="no" } else={ /ip hotspot user profile set [/ip hotspot user profile find where name="hs-high"] name="hs-high" rate-limit="20M/50M" shared-users="1" transparent-proxy="no" } } on-error={ :put "  FAILED: Hotspot speed profile 3" }
:global zxNodemcuIP; :global zxNodemcuMAC; :do { :if ([:len [/ip hotspot ip-binding find where mac-address=$zxNodemcuMAC]] = 0) do={ /ip hotspot ip-binding add type="bypassed" address=$zxNodemcuIP mac-address=$zxNodemcuMAC comment="zxheifi: NodeMCU" } else={ :put "  skipped (already exists, not created by ZxheiFi): Let the NodeMCU bypass the hotspot" } } on-error={ :put "  FAILED: Let the NodeMCU bypass the hotspot" }
:global zxNodemcuIP; :do { :if ([:len [/ip hotspot walled-garden ip find where comment="zxheifi: NodeMCU API"]] = 0) do={ /ip hotspot walled-garden ip add action="accept" dst-address=$zxNodemcuIP comment="zxheifi: NodeMCU API" } else={ /ip hotspot walled-garden ip set [/ip hotspot walled-garden ip find where comment="zxheifi: NodeMCU API"] action="accept" dst-address=$zxNodemcuIP comment="zxheifi: NodeMCU API" } } on-error={ :put "  FAILED: Let the login page reach the NodeMCU" }

# ============================================================================
# 4. PPPOE SERVER
#    Optional subscriber PPPoE mode - uses a port marked "PPPoE" if any, otherwise shares the hotspot interface.
# ============================================================================
:put "ZxheiFi: PPPoE Server"
:do { :if ([:len [/ip pool find where name="zxheifi-pppoe-pool"]] = 0) do={ /ip pool add name="zxheifi-pppoe-pool" ranges="10.0.10.10-10.0.10.200" } else={ /ip pool set [/ip pool find where name="zxheifi-pppoe-pool"] name="zxheifi-pppoe-pool" ranges="10.0.10.10-10.0.10.200" } } on-error={ :put "  FAILED: PPPoE address pool" }
:do { :if ([:len [/ppp profile find where name="pppoe-default"]] = 0) do={ /ppp profile add name="pppoe-default" rate-limit="5M/10M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } else={ /ppp profile set [/ppp profile find where name="pppoe-default"] name="pppoe-default" rate-limit="5M/10M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } } on-error={ :put "  FAILED: PPPoE speed profile 1" }
:do { :if ([:len [/ppp profile find where name="pppoe-gaming"]] = 0) do={ /ppp profile add name="pppoe-gaming" rate-limit="10M/30M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } else={ /ppp profile set [/ppp profile find where name="pppoe-gaming"] name="pppoe-gaming" rate-limit="10M/30M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } } on-error={ :put "  FAILED: PPPoE speed profile 2" }
:do { :if ([:len [/ppp profile find where name="pppoe-high"]] = 0) do={ /ppp profile add name="pppoe-high" rate-limit="20M/50M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } else={ /ppp profile set [/ppp profile find where name="pppoe-high"] name="pppoe-high" rate-limit="20M/50M" local-address="10.0.10.1" remote-address="zxheifi-pppoe-pool" dns-server="10.0.10.1" use-compression="yes" use-encryption="yes" use-mpls="no" only-one="yes" comment="zxheifi" } } on-error={ :put "  FAILED: PPPoE speed profile 3" }
:do { :if ([:len [/interface pppoe-server server find where service-name="ZxheiFi-PPPoE"]] = 0) do={ /interface pppoe-server server add service-name="ZxheiFi-PPPoE" interface="zxheifi-lan" default-profile="pppoe-default" authentication="pap,chap,mschap1,mschap2" one-session-per-host="yes" max-sessions="50" keepalive-timeout="60" disabled="no" } else={ /interface pppoe-server server set [/interface pppoe-server server find where service-name="ZxheiFi-PPPoE"] service-name="ZxheiFi-PPPoE" interface="zxheifi-lan" default-profile="pppoe-default" authentication="pap,chap,mschap1,mschap2" one-session-per-host="yes" max-sessions="50" keepalive-timeout="60" disabled="no" } } on-error={ :put "  FAILED: PPPoE server" }

# ============================================================================
# 5. GAMING QOS
#    Shapes traffic to your Bandwidth Down/Up and lets game traffic go first. Set those two fields to ~90% of your real internet speed.
# ============================================================================
:put "ZxheiFi: Gaming QoS"
:do { /queue tree remove [/queue tree find where name="gaming-priority"] } on-error={ :put "  FAILED: Remove old queue tree 'gaming-priority'" }
:do { /queue tree remove [/queue tree find where name="default-traffic"] } on-error={ :put "  FAILED: Remove old queue tree 'default-traffic'" }
:do { :if ([:len [/queue type find where name="zxheifi-fq-codel"]] = 0) do={ /queue type add name="zxheifi-fq-codel" kind="fq-codel" fq-codel-ecn="no" fq-codel-target="5ms" fq-codel-interval="100ms" fq-codel-quantum="1514" } else={ /queue type set [/queue type find where name="zxheifi-fq-codel"] name="zxheifi-fq-codel" kind="fq-codel" fq-codel-ecn="no" fq-codel-target="5ms" fq-codel-interval="100ms" fq-codel-quantum="1514" } } on-error={ :put "  FAILED: fq-codel queue type" }
:do { :if ([:len [/ip firewall mangle find where comment="zxheifi: gaming UDP (consoles/PC)"]] = 0) do={ /ip firewall mangle add chain="prerouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" dst-port="3074,3478-3479,12000-12099,27000-27030,30000-30099" comment="zxheifi: gaming UDP (consoles/PC)" } else={ /ip firewall mangle set [/ip firewall mangle find where comment="zxheifi: gaming UDP (consoles/PC)"] chain="prerouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" dst-port="3074,3478-3479,12000-12099,27000-27030,30000-30099" comment="zxheifi: gaming UDP (consoles/PC)" } } on-error={ :put "  FAILED: Mark gaming UDP (consoles/PC)" }
:do { :if ([:len [/ip firewall mangle find where comment="zxheifi: gaming UDP return (consoles/PC)"]] = 0) do={ /ip firewall mangle add chain="postrouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" src-port="3074,3478-3479,12000-12099,27000-27030,30000-30099" comment="zxheifi: gaming UDP return (consoles/PC)" } else={ /ip firewall mangle set [/ip firewall mangle find where comment="zxheifi: gaming UDP return (consoles/PC)"] chain="postrouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" src-port="3074,3478-3479,12000-12099,27000-27030,30000-30099" comment="zxheifi: gaming UDP return (consoles/PC)" } } on-error={ :put "  FAILED: Mark gaming UDP return (consoles/PC)" }
:do { :if ([:len [/ip firewall mangle find where comment="zxheifi: gaming UDP (mobile, approx range)"]] = 0) do={ /ip firewall mangle add chain="prerouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" dst-port="5000-9999,13000-19999,21000-26999" comment="zxheifi: gaming UDP (mobile, approx range)" } else={ /ip firewall mangle set [/ip firewall mangle find where comment="zxheifi: gaming UDP (mobile, approx range)"] chain="prerouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" dst-port="5000-9999,13000-19999,21000-26999" comment="zxheifi: gaming UDP (mobile, approx range)" } } on-error={ :put "  FAILED: Mark gaming UDP (mobile, approx range)" }
:do { :if ([:len [/ip firewall mangle find where comment="zxheifi: gaming UDP return (mobile, approx range)"]] = 0) do={ /ip firewall mangle add chain="postrouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" src-port="5000-9999,13000-19999,21000-26999" comment="zxheifi: gaming UDP return (mobile, approx range)" } else={ /ip firewall mangle set [/ip firewall mangle find where comment="zxheifi: gaming UDP return (mobile, approx range)"] chain="postrouting" action="mark-packet" new-packet-mark="gaming-udp" passthrough="no" protocol="udp" src-port="5000-9999,13000-19999,21000-26999" comment="zxheifi: gaming UDP return (mobile, approx range)" } } on-error={ :put "  FAILED: Mark gaming UDP return (mobile, approx range)" }
:global zxDown; :do { :if ([:len [/queue tree find where name="zxheifi-down"]] = 0) do={ /queue tree add name="zxheifi-down" parent="zxheifi-lan" max-limit=$zxDown comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-down"] name="zxheifi-down" parent="zxheifi-lan" max-limit=$zxDown comment="zxheifi" } } on-error={ :put "  FAILED: Download cap" }
:do { :if ([:len [/queue tree find where name="zxheifi-down-gaming"]] = 0) do={ /queue tree add name="zxheifi-down-gaming" parent="zxheifi-down" packet-mark="gaming-udp" priority="1" queue="zxheifi-fq-codel" comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-down-gaming"] name="zxheifi-down-gaming" parent="zxheifi-down" packet-mark="gaming-udp" priority="1" queue="zxheifi-fq-codel" comment="zxheifi" } } on-error={ :put "  FAILED: Download: gaming first" }
:do { :if ([:len [/queue tree find where name="zxheifi-down-other"]] = 0) do={ /queue tree add name="zxheifi-down-other" parent="zxheifi-down" packet-mark="no-mark" priority="8" queue="zxheifi-fq-codel" comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-down-other"] name="zxheifi-down-other" parent="zxheifi-down" packet-mark="no-mark" priority="8" queue="zxheifi-fq-codel" comment="zxheifi" } } on-error={ :put "  FAILED: Download: everything else" }
:global zxUp; :do { :if ([:len [/queue tree find where name="zxheifi-up"]] = 0) do={ /queue tree add name="zxheifi-up" parent="ether1" max-limit=$zxUp comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-up"] name="zxheifi-up" parent="ether1" max-limit=$zxUp comment="zxheifi" } } on-error={ :put "  FAILED: Upload cap" }
:do { :if ([:len [/queue tree find where name="zxheifi-up-gaming"]] = 0) do={ /queue tree add name="zxheifi-up-gaming" parent="zxheifi-up" packet-mark="gaming-udp" priority="1" queue="zxheifi-fq-codel" comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-up-gaming"] name="zxheifi-up-gaming" parent="zxheifi-up" packet-mark="gaming-udp" priority="1" queue="zxheifi-fq-codel" comment="zxheifi" } } on-error={ :put "  FAILED: Upload: gaming first" }
:do { :if ([:len [/queue tree find where name="zxheifi-up-other"]] = 0) do={ /queue tree add name="zxheifi-up-other" parent="zxheifi-up" packet-mark="no-mark" priority="8" queue="zxheifi-fq-codel" comment="zxheifi" } else={ /queue tree set [/queue tree find where name="zxheifi-up-other"] name="zxheifi-up-other" parent="zxheifi-up" packet-mark="no-mark" priority="8" queue="zxheifi-fq-codel" comment="zxheifi" } } on-error={ :put "  FAILED: Upload: everything else" }

# ============================================================================
# 6. CONTENT FILTERING
#    Switches the router's DNS to CleanBrowsing Family Filter, forces customers through it, and blocks the DNS-over-TLS bypass.
# ============================================================================
:put "ZxheiFi: Content Filtering"
:do { /ip dns set servers="185.228.168.168,185.228.169.168" allow-remote-requests="yes" } on-error={ :put "  FAILED: Router DNS: CleanBrowsing Family Filter" }
:do { :if ([:len [/ip firewall nat find where comment="zxheifi: force DNS (UDP)"]] = 0) do={ /ip firewall nat add chain="dstnat" action="redirect" to-ports="53" protocol="udp" dst-port="53" in-interface="zxheifi-lan" comment="zxheifi: force DNS (UDP)" } else={ /ip firewall nat set [/ip firewall nat find where comment="zxheifi: force DNS (UDP)"] chain="dstnat" action="redirect" to-ports="53" protocol="udp" dst-port="53" in-interface="zxheifi-lan" comment="zxheifi: force DNS (UDP)" } } on-error={ :put "  FAILED: Force DNS through the router (UDP)" }
:do { :if ([:len [/ip firewall nat find where comment="zxheifi: force DNS (TCP)"]] = 0) do={ /ip firewall nat add chain="dstnat" action="redirect" to-ports="53" protocol="tcp" dst-port="53" in-interface="zxheifi-lan" comment="zxheifi: force DNS (TCP)" } else={ /ip firewall nat set [/ip firewall nat find where comment="zxheifi: force DNS (TCP)"] chain="dstnat" action="redirect" to-ports="53" protocol="tcp" dst-port="53" in-interface="zxheifi-lan" comment="zxheifi: force DNS (TCP)" } } on-error={ :put "  FAILED: Force DNS through the router (TCP)" }
:do { :if ([:len [/ip firewall filter find where comment="zxheifi: block DNS-over-TLS"]] = 0) do={ /ip firewall filter add chain="forward" action="drop" protocol="tcp" dst-port="853" in-interface="zxheifi-lan" comment="zxheifi: block DNS-over-TLS" } else={ /ip firewall filter set [/ip firewall filter find where comment="zxheifi: block DNS-over-TLS"] chain="forward" action="drop" protocol="tcp" dst-port="853" in-interface="zxheifi-lan" comment="zxheifi: block DNS-over-TLS" } } on-error={ :put "  FAILED: Block DNS-over-TLS bypass" }

# ============================================================================
# 7. DAILY REBOOT SCHEDULER
#    Reboots the router at 03:00 daily. Needs Scheduler enabled in RouterOS device-mode.
# ============================================================================
:put "ZxheiFi: Daily Reboot Scheduler"
:do { :if ([:len [/system scheduler find where name="zxheifi-daily-reboot"]] = 0) do={ /system scheduler add name="zxheifi-daily-reboot" interval="1d" start-time="03:00:00" on-event="/system reboot" policy="reboot,read,write,policy,test" comment="zxheifi" } else={ /system scheduler set [/system scheduler find where name="zxheifi-daily-reboot"] name="zxheifi-daily-reboot" interval="1d" start-time="03:00:00" on-event="/system reboot" policy="reboot,read,write,policy,test" comment="zxheifi" } } on-error={ :put "  FAILED: Daily reboot at 03:00" }

# ============================================================================
# 8. NODEMCU API ACCESS
#    Creates the account the NodeMCU logs in with (needs write access to create customer logins).
# ============================================================================
:put "ZxheiFi: NodeMCU API Access"
:do { :if ([:len [/user group find where name="zxheifi-api"]] = 0) do={ /user group add name="zxheifi-api" policy="read,write,api,test" comment="zxheifi" } else={ /user group set [/user group find where name="zxheifi-api"] name="zxheifi-api" policy="read,write,api,test" comment="zxheifi" } } on-error={ :put "  FAILED: NodeMCU API permission group" }
:global zxApiPass; :do { :if ([:len [/user find where name="zxheifi-api"]] = 0) do={ /user add name="zxheifi-api" group="zxheifi-api" password=$zxApiPass comment="zxheifi" } else={ /user set [/user find where name="zxheifi-api"] name="zxheifi-api" group="zxheifi-api" password=$zxApiPass comment="zxheifi" } } on-error={ :put "  FAILED: NodeMCU API user" }
:do { /user group remove [/user group find where name="api-read"] } on-error={ :put "  FAILED: Remove old read-only 'api-read' group" }

# Forget the edit-me values so they don't linger in the router's environment.
/system script environment remove [find where name~"^zx"]
:put "ZxheiFi: done. Look above for any FAILED lines."
